-- Webhook Engine
local function sendWebhook(fruitName, dist)
    if Config.WebhookUrl == "" then return end
    local cleanName, data = getFruitInfo(fruitName)

    local payload = HttpService:JSONEncode({
        ["username"] = "Kira Master Notifier",
        ["embeds"] = {{
            ["title"] = "Fruit Spawned in Server!",
            ["description"] = string.format("**Fruit:** `%s`\n**Rarity:** %s\n**Distance:** %d studs\n**Job ID:** `%s`", cleanName, data.Rarity, dist, JobId),
            ["color"] = 16711808
        }}
    })

    pcall(function()
        local req = (syn and syn.request) or (http and http.request) or http_request or request
        if req then
            req({
                Url = Config.WebhookUrl,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = payload
            })
        end
    end)
end

-- Server Hopper Engine
local VisitedServers = {}
local function hopToNextServer()
    StatusBox.Text = "Status: Searching for next server..."
    local apiUrl = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", PlaceId)

    local success, response = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(apiUrl))
    end)

    if success and response and response.data then
        for _, server in ipairs(response.data) do
            if server.id ~= JobId and server.playing < server.maxPlayers and not VisitedServers[server.id] then
                StatusBox.Text = "Status: Joining low-player server..."
                VisitedServers[server.id] = true
                TeleportService:TeleportToPlaceInstance(PlaceId, server.id, LocalPlayer)
                return
            end
        end
    end

    task.wait(2)
    hopToNextServer()
end

