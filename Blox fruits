-- Tab System Builder
local Tabs = {}
local TabButtons = {}

local function createTab(name, active)
    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = AquaTheme.Accent
    page.Visible = active
    page.Parent = Container

    local list = Instance.new("UIListLayout")
    list.Padding = UDim.new(0, 8)
    list.Parent = page

    Tabs[name] = page

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 32)
    btn.Position = UDim2.new(0, 5, 0, #TabButtons * 38 + 6)
    btn.BackgroundColor3 = active and AquaTheme.Accent or AquaTheme.DarkContainer
    btn.Text = name
    btn.TextColor3 = active and Color3.fromRGB(10, 10, 15) or AquaTheme.TextPrimary
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.Parent = Sidebar

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        for tName, tPage in pairs(Tabs) do tPage.Visible = (tName == name) end
        for _, b in ipairs(TabButtons) do
            b.BackgroundColor3 = AquaTheme.DarkContainer
            b.TextColor3 = AquaTheme.TextPrimary
        end
        btn.BackgroundColor3 = AquaTheme.Accent
        btn.TextColor3 = Color3.fromRGB(10, 10, 15)
    end)

    table.insert(TabButtons, btn)
    return page
end

