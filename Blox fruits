-- Main Execution & Fruit Filtering Sequence
local foundTarget = false

for _, child in ipairs(Workspace:GetChildren()) do
    if child:IsA("Tool") and (child.Name:find("Fruit") or child.Name:find("Pha-")) then
        if Config.TargetFruitOnly == "" or child.Name:lower():find(Config.TargetFruitOnly:lower()) then
            local handle = child:FindFirstChild("Handle") or child:FindFirstChildWhichIsA("BasePart")
            if handle then
                foundTarget = true

                local playerPos = LocalPlayer.Character and LocalPlayer.Character.HumanoidRootPart.Position
                local dist = playerPos and math.floor((playerPos - handle.Position).Magnitude) or 0

                logFruitToServerHistory(child.Name)

                createESP(child, handle, child.Name)
                showAlert(child.Name, dist, "FRUIT SPAWN")
                sendWebhook(child.Name, dist, "Fruit")

                task.spawn(function()
                    if Config.AutoCollect then
                        local character = LocalPlayer.Character
                        if character and character:FindFirstChild("HumanoidRootPart") then
                            local root = character.HumanoidRootPart
                            StatusLabel.Text = "Status: Collecting " .. child.Name .. "..."

                            local tweenInfo = TweenInfo.new(dist / Config.TweenSpeed, Enum.EasingStyle.Linear)
                            local tween = TweenService:Create(root, tweenInfo, {CFrame = handle.CFrame * CFrame.new(0, 2, 0)})

                            tween:Play()
                            tween.Completed:Wait()

                            firetouchinterest(root, handle, 0)
                            task.wait(0.1)
                            firetouchinterest(root, handle, 1)

                            if Config.AutoStore then
                                task.wait(0.5)
                                local storeRemote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
                                if storeRemote then
                                    storeRemote:InvokeServer("StoreFruit", child.Name, child)
                                    StatusLabel.Text = "Status: Stored " .. child.Name .. "!"
                                end
                            end
                        end
                    end
                end)
                break
            end
        end
    end
end

-- Check for Event NPCs if enabled and no fruit found
if not foundTarget and Config.DetectNPCs then
    local npcsFolder = Workspace:FindFirstChild("NPCs") or Workspace:FindFirstChild("Enemies")
    if npcsFolder then
        for _, npc in ipairs(npcsFolder:GetChildren()) do
            if npc.Name:find("Magnet") or npc.Name:find("Boss") or npc.Name:find("Event") then
                local root = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChildWhichIsA("BasePart")
                if root then
                    foundTarget = true
                    local playerPos = LocalPlayer.Character and LocalPlayer.Character.HumanoidRootPart.Position
                    local dist = playerPos and math.floor((playerPos - root.Position).Magnitude) or 0

                    createESP(npc, root, npc.Name)
                    showAlert(npc.Name, dist, "EVENT NPC")
                    sendWebhook(npc.Name, dist, "Event NPC")
                    StatusLabel.Text = "Status: Event NPC Found (" .. npc.Name .. ")!"
                    break
                end
            end
        end
    end
end

-- Fast Hop execution if no valid fruit was found
if not foundTarget then
    StatusLabel.Text = string.format("Status: Map empty or filter unmatched. Hopping in %d seconds...", Config.FastScanDelay)
    task.delay(Config.FastScanDelay, function()
        if Config.AutoServerHop and not foundTarget then
            hopToNextServer()
        end
    end)
else
    if StatusLabel.Text:find("Scanning") or StatusLabel.Text:find("empty") then
        StatusLabel.Text = "Status: Spawn Detected! Holding position."
    end
end
