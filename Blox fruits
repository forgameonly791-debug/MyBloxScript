-- FIXED BLOX FRUITS DETECTION ENGINE
local function scanForFruits()
    local detectedFruits = {}

    local function checkItem(item)
        if item:IsA("Tool") or item:IsA("Model") then
            local lowerName = item.Name:lower()
            if lowerName:find("fruit") or lowerName:find("pha-") or FruitData[item.Name] then
                local handle = item:FindFirstChild("Handle") or item:FindFirstChildWhichIsA("BasePart")
                if handle then
                    table.insert(detectedFruits, {Object = item, Handle = handle, Name = item.Name})
                end
            end
        end
    end

    -- Check Workspace root and Workspace.Fruits folder
    for _, child in ipairs(Workspace:GetChildren()) do checkItem(child) end
    local fruitFolder = Workspace:FindFirstChild("Fruits")
    if fruitFolder then
        for _, child in ipairs(fruitFolder:GetChildren()) do checkItem(child) end
    end

    return detectedFruits
end

-- Execution Loop
task.spawn(function()
    while task.wait(1) do
        local fruits = scanForFruits()

        if #fruits > 0 then
            for _, fruitData in ipairs(fruits) do
                local fruitName = fruitData.Name
                local handle = fruitData.Handle
                local obj = fruitData.Object

                if Config.TargetFruitOnly == "" or fruitName:lower():find(Config.TargetFruitOnly:lower()) then
                    local playerPos = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position
                    local dist = playerPos and math.floor((playerPos - handle.Position).Magnitude) or 0

                    StatusBox.Text = string.format("FOUND: %s (%d studs)", fruitName, dist)
                    createESP(obj, handle, fruitName)
                    sendWebhook(fruitName, dist)

                    if Config.AutoCollect then
                        local char = LocalPlayer.Character
                        if char and char:FindFirstChild("HumanoidRootPart") then
                            local root = char.HumanoidRootPart
                            StatusBox.Text = "Collecting " .. fruitName .. "..."

                            local tweenInfo = TweenInfo.new(dist / Config.TweenSpeed, Enum.EasingStyle.Linear)
                            local tween = TweenService:Create(root, tweenInfo, {CFrame = handle.CFrame * CFrame.new(0, 2, 0)})
                            tween:Play()
                            tween.Completed:Wait()

                            firetouchinterest(root, handle, 0)
                            task.wait(0.1)
                            firetouchinterest(root, handle, 1)

                            if Config.AutoStore then
                                task.wait(0.5)
                                local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
                                if commF then
                                    commF:InvokeServer("StoreFruit", fruitName, obj)
                                    StatusBox.Text = "Stored " .. fruitName .. "!"
                                end
                            end
                        end
                    end
                    break
                end
            end
        else
            StatusBox.Text = "Status: No fruits on map."
            if Config.AutoServerHop then
                task.wait(Config.FastScanDelay)
                hopToNextServer()
            end
        end
    end
end)
