local function getFruitInfo(fullName)
    for key, data in pairs(FruitData) do
        if fullName:lower():find(key:lower()) then
            return key, data
        end
    end
    return fullName, {Rarity = "Unknown", Color = Color3.fromRGB(0, 255, 150)}
end

