local function showAlert(rawName, distance, category)
    local cleanName, data = getFruitInfo(rawName)
    AlertStroke.Color = data.Color
    AlertTitle.Text = string.format("[%s] %s DETECTED!", data.Rarity:upper(), category or "FRUIT")
    AlertText.Text = string.format("%s\nDistance: %d studs", cleanName, distance)
    AlertBanner.Visible = true

    task.delay(7, function() AlertBanner.Visible = false end)
end

-- Discord Webhook Engine
local function sendWebhook(rawName, distance, category)
    if Config.WebhookUrl == "" then return end

    local cleanName, data = getFruitInfo(rawName)

    local payload = HttpService:JSONEncode({
        ["username"] = "Kira Master Notifier",
        ["embeds"] = {{
            ["title"] = string.format("%s Spawn Detected in Server!", category or "Fruit"),
            ["description"] = string.format("**Fruit Name:** `%s`\n**Rarity:** %s\n**Distance:** %d studs\n**Server Job ID:** `%s`\n**Time:** %s", cleanName, data.Rarity, distance, JobId, os.date("%X")),
            ["color"] = 16711808,
            ["footer"] = {["text"] = "Automated Fruit & Server Hop System"}
        }}
    })

    pcall(function()
        local req = (syn and syn.request) or (http and http.request) or http_request or request
        if req then
            req({
                Url = Config.WebhookUrl,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = payload
            })
        end
    end)
end

