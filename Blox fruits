-- Server Hopper Engine
local function hopToNextServer()
    StatusLabel.Text = "Status: Searching for next server..."
    local sortOrder = Config.LowPlayerSearch and "Asc" or "Desc"
    local apiUrl = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=%s&limit=100", PlaceId, sortOrder)

    local success, response = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(apiUrl))
    end)

    if success and response and response.data then
        for _, server in ipairs(response.data) do
            if server.id ~= JobId and server.playing < server.maxPlayers and not VisitedServers[server.id] then
                StatusLabel.Text = string.format("Status: Joining server (%d/%d players)...", server.playing, server.maxPlayers)

                VisitedServers[server.id] = os.time()
                if writefile then
                    pcall(function() writefile(BlacklistFile, HttpService:JSONEncode(VisitedServers)) end)
                end

                TeleportService:TeleportToPlaceInstance(PlaceId, server.id, LocalPlayer)
                return
            end
        end
    end

    task.wait(2)
    hopToNextServer()
end

