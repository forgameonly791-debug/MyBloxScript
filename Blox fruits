-- Player ESP Routine
local function updatePlayerESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local root = player.Character.HumanoidRootPart
            local esp = root:FindFirstChild("TaiyoPlayerESP")
            
            if Config.PlayerESP then
                if not esp then
                    local hl = Instance.new("Highlight")
                    hl.Name = "TaiyoPlayerESP"
                    hl.Adornee = player.Character
                    hl.FillColor = AquaTheme.Accent
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.Parent = root
                end
            else
                if esp then esp:Destroy() end
            end
        end
    end
end

-- Auto-Equip Best Weapon Routine
local function equipWeapon()
    if not Config.AutoEquipWeapon then return end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    if backpack and char then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.ToolTip == "Sword" or tool.ToolTip == "Blox Fruit") then
                char.Humanoid:EquipTool(tool)
                break
            end
        end
    end
end

-- Fixed Error-Free Server Hopper Engine
local VisitedServers = {}
local function hopToNextServer()
    StatusBox.Text = "Status: Searching active servers..."
    local apiUrl = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", PlaceId)

    local success, response = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(apiUrl))
    end)

    if success and response and response.data then
        for _, server in ipairs(response.data) do
            if server.id ~= JobId and server.playing > 1 and server.playing < server.maxPlayers and not VisitedServers[server.id] then
                VisitedServers[server.id] = true
                StatusBox.Text = string.format("Status: Teleporting (%d/%d)...", server.playing, server.maxPlayers)
                
                local tpSuccess = pcall(function()
                    TeleportService:TeleportToPlaceInstance(PlaceId, server.id, LocalPlayer)
                end)
                
                if tpSuccess then return end
            end
        end
    end

    -- CommF_ Native ServerHop Fallback
    StatusBox.Text = "Status: Executing native hop..."
    pcall(function()
        ReplicatedStorage.Remotes.CommF_:InvokeServer("ServerHop")
    end)
end

HopBtn.MouseButton1Click:Connect(hopToNextServer)

